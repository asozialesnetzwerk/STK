;; -*- mode: lisp -*-

(tuxkart-kart
 (name        "Hexley")
 (model-file  "hexley.ac")
 (icon-file   "hexleyicon.rgb")
 (shadow-file "hexleyshadow.rgb") 
 (groups      "standard")
 (engine-sound "small")
 (rgb         0.9 0.2 0.2)

 (wheel-radius  0.15)
 (wheel-front-right
    (position 0.258387 0.408599 0.107701)
    (model    "wheel-front-right.ac")
  )
  (wheel-front-left
    (position -0.248516 0.408602 0.107698)
    (model    "wheel-front-left.ac")
  )
  (wheel-rear-right
    (position 0.268520 -0.357958 0.107698)
    (model    "wheel-rear-right.ac")
  )
  (wheel-rear-left
    (position -0.258649 -0.357955 0.107701)
    (model    "wheel-rear-left.ac")
  )
       
)

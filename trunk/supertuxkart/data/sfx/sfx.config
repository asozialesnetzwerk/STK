;; -*- mode: lisp -*-

(sfx-config
   (ugh 
      (filename   "ugh.wav") ;; The name of the wav file associated with this Sound effect
      (volume     1.0   )    ;; Range: 0.0 (silent) to 1.0 (full volume)
      (roll-off   0.1   )    ;; The ammount of volume that is subtracted for every unit
                             ;; of distance between the sound and the listener.
      (positional 0  )       ;; 1 = true, 0 = false
   )
   (winner
      (filename   "radio/grandprix_winner.wav")
      (volume     1.0   )
      (roll-off   0.1   )
      (positional 0     )
   )

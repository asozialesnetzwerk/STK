;; -*- mode: lisp -*-

(tuxkart-track
 (name     _("Crescent Crossing"))
 (designer "Ingo Ruhnke & Marianne Gagnon")
 
  (sky-color    0.45 0.0 0.0 0.0)

 (sun-ambient  0.2 0.1 0.1)
 (sun-diffuse  0.2 0.1 0.1)
 (sun-specular 0.2 0.1 0.1)

 (music      "KingArthursCastle.music")
 (screenshot "sshot-crescent.rgb")
 (topview    "topview-crescent.rgb")
 (AI-curve-speed-adjust  3.0)
 (AI-angle-adjust        3.3)
)


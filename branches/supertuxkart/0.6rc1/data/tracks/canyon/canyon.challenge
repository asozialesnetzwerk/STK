(challenge
 (id            "tollwaytime")
 (name          _("Finish Tux Tollway track in 3:00"))
 (description   _("Finish 3 laps on the Tux Tollway\ntrack with 3 AI karts\nin under 3:00 minutes."))
 (unlock-track "canyon")
 (major        "single")
 (minor        "quickrace")
 (track        "tuxtrack")
 (difficulty   "easy")
 (laps         3)
 (karts        4)
 (time       180)
)


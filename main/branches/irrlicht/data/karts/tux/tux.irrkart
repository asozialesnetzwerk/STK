;; -*- mode: lisp -*-

(tuxkart-kart
 (name        "Tux")
 (version     1)
 (model-file  "tux.b3d")
 (icon-file   "tuxicon.png")
 (shadow-file "tuxkartshadow.png")
 (groups      "standard") 
 (engine-sound "small")
 (horn-sound  "horn.ogg")
 (rgb         0.7 0.0 0.0)
 (wheel-front-right
   (position  0.295  0.412 0.103)
   (model     "wheel-front-right.b3d")
 )
 (wheel-front-left
   (position  -0.285  0.412 0.103)
   (model     "wheel-front-left.b3d")
 )
 (wheel-rear-right
   (position  0.361 -0.344 0.143)
   (model     "wheel-rear-right.b3d")
 )
 (wheel-rear-left
   (position  -0.349 -0.344 0.143)
   (model     "wheel-rear-left.b3d")
 )
)
